#!/usr/bin/env bash

set -euo pipefail

repo=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
expected_repo=/home/ol4vr/Projects/omarchy-plus-apps/omarchy-plus-mouse-control
plugin_id=io.github.ol4vr.mouse-control
plugin_root=/home/ol4vr/.config/omarchy/plugins
target="$plugin_root/$plugin_id"
mode=${1:-remove}

case "$mode" in
  remove|--check) ;;
  *) echo "Usage: $0 [--check]" >&2; exit 2 ;;
esac
[[ "$repo" == "$expected_repo" ]] || { echo "Refusing unexpected source path: $repo" >&2; exit 1; }

if [[ ! -e "$target" ]]; then
  echo "No Mouse Control development copy is present."
  [[ "$mode" != --check ]] || echo "Mouse Control development removal check: PASS"
  exit 0
fi
[[ -d "$target" && ! -e "$target/.git" && -f "$target/.omarchy-plus-development" ]] || {
  echo "Refusing unrecognized plugin target: $target" >&2; exit 1;
}
expected_marker=$(mktemp /tmp/omarchy-plus-mouse-control-marker.XXXXXX)
trap 'rm -f -- "$expected_marker"' EXIT
printf '%s\n' 'schema=1' "id=$plugin_id" "source=$expected_repo" > "$expected_marker"
cmp -s "$expected_marker" "$target/.omarchy-plus-development" || {
  echo "Refusing development directory with a foreign marker: $target" >&2; exit 1;
}

if [[ "$mode" == --check ]]; then
  echo "Mouse Control development removal check: PASS"
  echo "Recognized removable target: $target"
  exit 0
fi
rm -rf -- "$target"
omarchy-shell shell rescanPlugins
echo "Removed Mouse Control development copy: $target"
echo "The source repository, mouse services, and hardware were not changed."
